{
  "schema": "figsmith.ir/1.0",
  "meta": {
    "domain": "paper-figure",
    "chart_type": "bar_grouped",
    "tokens": "academic",
    "title": "Figure 2. Dose-response comparison",
    "width_unit": 100
  },
  "content": {
    "labels": {},
    "axis": {
      "x": "Condition",
      "y": "Response (a.u.)"
    },
    "legend": [
      "Experiment",
      "Control"
    ],
    "footnote": "Mean ± SD, n = 32 per group."
  },
  "topology": {
    "nodes": [],
    "edges": []
  },
  "layout": {
    "canvas": {
      "margin": 4,
      "figsize_inches": [
        7.0,
        4.4
      ]
    },
    "grid": {
      "columns": 2,
      "gap_x": 4.0,
      "gap_y": 4.0,
      "box_w": 30,
      "box_h": 20
    },
    "nodes": {}
  },
  "style": {
    "fill": {},
    "stroke": {
      "default": "colors.border",
      "width": "stroke.thin"
    },
    "text": {
      "default": "fonts.role.axis_label",
      "size": "fonts.size_pt.axis_label",
      "color": "colors.ink"
    },
    "emphasis": []
  },
  "data": {
    "source": "data\\dose_response.csv",
    "categories": [
      "baseline",
      "low_dose",
      "mid_dose",
      "high_dose",
      "recovery"
    ],
    "series": [
      {
        "name": "Experiment",
        "columns": {
          "x": "condition",
          "y": "experiment_mean",
          "yerr": "experiment_sd"
        },
        "error_kind": "SD",
        "kind": "bar_grouped",
        "width": 0.36
      },
      {
        "name": "Control",
        "columns": {
          "x": "condition",
          "y": "control_mean",
          "yerr": "control_sd"
        },
        "error_kind": "SD",
        "kind": "bar_grouped",
        "width": 0.36
      }
    ],
    "units": {
      "x": "condition",
      "y": "a.u."
    },
    "statistics": {
      "test": "two-sided Welch t-test, experiment vs control within condition",
      "alpha": 0.05,
      "n": 32,
      "correction": "Benjamini-Hochberg across 5 conditions"
    }
  }
}